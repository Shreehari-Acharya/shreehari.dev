---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import profile from "../../contents/profile.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content, headings } = await render(post);

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = tocItems.length > 1;

const siteUrl = "https://shreehari.dev";
const ogImage = post.data.cover
  ? new URL(post.data.cover.src, siteUrl).href
  : undefined;
---

<Layout
  title={`${post.data.title} | ${profile.name}`}
  description={post.data.description}
  image={ogImage}
  type="article"
  pubDate={post.data.pubDate.toISOString()}
  tags={post.data.tags}
>
  <main class="min-h-svh px-6 py-20">
    <article class="prose-custom mx-auto max-w-200">
      <nav
        aria-label="Breadcrumb"
        class="mb-6 flex items-center gap-1.5 text-xs sm:text-sm text-muted-foreground"
      >
        <a
          href="/"
          style="text-decoration:none"
          class="transition-colors hover:text-foreground">Home</a
        >
        <span aria-hidden="true">&gt;</span>
        <a
          href="/blogs"
          style="text-decoration:none"
          class="transition-colors hover:text-foreground">Blogs</a
        >
        <span aria-hidden="true">&gt;</span>
        <span class="text-foreground" aria-current="page"
          >{post.data.title}</span
        >
      </nav>
      <header>
        <time class="text-xs text-muted-foreground">
          {
            post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <h1 class="mt-1 text-2xl font-medium text-foreground">
          {post.data.title}
        </h1>
        {
          post.data.tags ? (
            <div class="mt-2 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>
          ) : null
        }
        {
          post.data.cover ? (
            <Image
              src={post.data.cover}
              alt={post.data.coverAlt ?? ""}
              class="mt-6 w-full rounded-lg"
            />
          ) : null
        }
      </header>
      {
        hasToc && (
          <details class="xl:hidden mb-8 mt-8 rounded-lg border border-border">
            <summary class="cursor-pointer py-2 pl-5 text-sm font-medium text-foreground list-none ">
              Table of Contents
            </summary>
            <div class="border-t border-border px-4 py-2">
              <ul class="space-y-1">
                {tocItems.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                      class:list={[{ "pl-4": h.depth === 3 }, "block py-0.5"]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )
      }
      <div class="mt-8">
        <Content />
      </div>
    </article>
  </main>

  {
    hasToc && (
      <div class="hidden xl:block fixed right-8 top-24 w-66 max-h-[calc(100vh-8rem)] overflow-y-auto">
        <TableOfContents headings={headings} />
      </div>
    )
  }
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      author: {
        "@type": "Person",
        name: profile.name,
        url: "https://shreehari.dev",
      },
    })}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://shreehari.dev",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: "https://shreehari.dev/blogs",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: `https://shreehari.dev/blogs/${post.id}`,
        },
      ],
    })}
  />
</Layout>
