---
import { Image } from "astro:assets";
import { ExperienceList } from "../components/experience-list";
import { ProjectList } from "../components/project-list";
import { SocialLinks } from "../components/social-links";
import { TechStackMarquee } from "../components/tech-stack-marquee";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allPosts.slice(0, 3);
---

<Layout>
  <main
    class="mx-auto min-h-svh max-w-4xl px-6 py-20"
    aria-labelledby="page-title"
  >
    <section class="w-full">
      <h1
        id="page-title"
        class="font-heading text-4xl font-medium tracking-tight text-foreground sm:text-5xl"
      >
        Shreehari R Acharya
      </h1>
      <p class="text-sm text-muted-foreground font-medium">
        20 &#8226 Software Engineer
      </p>
      <p class="mt-3 text-base text-start text-muted-foreground font-light">
        Building scalable systems, developer tooling, Agentic and real-world
        applications. I work with Go and Typescript.
      </p>
      <SocialLinks />
      <TechStackMarquee />
      <ExperienceList />
      <ProjectList client:load />

      <section class="mt-10 w-full text-left" aria-labelledby="blog-title">
        <h2 id="blog-title" class="text-sm font-medium text-foreground/60">
          BLOG
        </h2>

        <div class="mt-4 space-y-6">
          {
            recentPosts.map((post) => (
              <article>
                <a
                  href={`/blogs/${post.id}`}
                  class="group flex items-start gap-4"
                >
                  {post.data.cover ? (
                    <Image
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? ""}
                      class="w-34 shrink-0 rounded-lg"
                    />
                  ) : null}
                  <div>
                    <time class="text-xs text-muted-foreground">
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                    <h2 class="mt-1 text-base font-medium text-foreground transition-colors group-hover:text-muted-foreground">
                      {post.data.title}
                    </h2>
                    <p class="mt-1 line-clamp-1 text-sm text-muted-foreground">
                      {post.data.description}
                    </p>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        <div class="mt-4 flex justify-center">
          <a
            href="/blogs"
            class="text-xs text-muted-foreground underline-offset-2 hover:underline"
          >
            Show all
          </a>
        </div>
      </section>
    </section>
  </main>
</Layout>
