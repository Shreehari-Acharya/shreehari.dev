---
import { Image } from "astro:assets";
import { ExperienceList } from "../components/experience-list";
import { ProjectList } from "../components/project-list";
import { SocialLinks } from "../components/social-links";
import { TechStackMarquee } from "../components/tech-stack-marquee";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import profile from "../contents/profile.json";
import social from "../contents/social.json";
import { GitHubContributions } from "../components/github-contributions";

const githubUsername = social.github.replace("https://github.com/", "");

const { name, description, role, birthdate } = profile;

const now = new Date();
const birth = new Date(birthdate);
const age =
  now.getFullYear() -
  birth.getFullYear() -
  (now < new Date(now.getFullYear(), birth.getMonth(), birth.getDate())
    ? 1
    : 0);

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allPosts.slice(0, 3);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  url: "https://shreehari.dev",
  image: "https://shreehari.dev/favicon.svg",
  sameAs: [social.github, social.linkedin, social.x],
  jobTitle: role,
  birthDate: birthdate,
};
---

<Layout>
  <main
    class="mx-auto min-h-svh max-w-4xl px-6 py-20"
    aria-labelledby="page-title"
  >
    <section class="w-full">
      <h1
        id="page-title"
        class="font-heading text-3xl font-medium tracking-tight text-foreground sm:text-5xl"
      >
        {name}
      </h1>
      <p class="text-xs sm:text-sm text-muted-foreground font-medium">
        {age} &#8226 {role}
      </p>
      <p
        class="mt-3 text-sm sm:text-base text-start text-muted-foreground font-light"
      >
        {description}
      </p>
      <SocialLinks />
      <TechStackMarquee />
      <ExperienceList />
      <GitHubContributions username={githubUsername} client:only="react" />
      <ProjectList client:load />

      <section class="mt-10 w-full text-left" aria-labelledby="blog-title">
        <h2 id="blog-title" class="text-sm font-medium text-foreground/60">
          BLOG
        </h2>

        <div class="mt-4 space-y-6">
          {
            recentPosts.map((post) => (
              <article>
                <a
                  href={`/blogs/${post.id}`}
                  class="group flex items-center gap-4"
                >
                  {post.data.cover ? (
                    <Image
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? ""}
                      class="w-28 sm:w-34 shrink-0 rounded-lg"
                    />
                  ) : null}
                  <div>
                    <time class="text-[10px] text-muted-foreground">
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                    <h2 class="mt-1 text-sm sm:text-base font-medium text-foreground transition-colors group-hover:text-muted-foreground">
                      {post.data.title}
                    </h2>
                    <p class="mt-1 line-clamp-1 text-xs sm:text-sm text-muted-foreground">
                      {post.data.description}
                    </p>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        <div class="mt-4 flex justify-center">
          <a
            href="/blogs"
            class="text-xs text-muted-foreground underline-offset-2 hover:underline"
          >
            View all posts
          </a>
        </div>
      </section>
    </section>
  </main>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
</Layout>
