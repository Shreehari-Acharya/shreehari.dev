---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | Shreehari R Acharya" description="Page not found.">
  <main
    class="mx-auto flex min-h-svh max-w-4xl flex-col items-center justify-center px-6 py-20 text-center"
  >
    <h1 class="font-heading text-6xl font-medium text-foreground">404</h1>
    <p class="mt-2 text-muted-foreground">Page not found.</p>
    <a
      href="/"
      class="mt-6 text-sm text-muted-foreground underline-offset-2 hover:underline"
    >
      Go home
    </a>
  </main>
</Layout>
